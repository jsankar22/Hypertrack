# Django Secrets
SECRET_KEY=django-insecure-some-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave DATABASE_URL empty/commented out to automatically fall back to SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# External API Configuration
# Get your API key from https://api.nal.usda.gov/
USDA_API_KEY=DEMO_KEY

# AI Fitness Coach chatbot
# LLM_PROVIDER: groq (free, Llama 3) or anthropic (Claude, production quality)
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# RAG tuning (optional)
# RAG_TOP_K=4
# RAG_MAX_DISTANCE=0.95
# CHAT_RATE_LIMIT_PER_MINUTE=15
